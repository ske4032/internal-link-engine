# Environment template for the Internal Linking Intelligence Engine.
#
# EVERY VALUE BELOW IS A PLACEHOLDER. Copy this file to `.env` and fill it in:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. Nothing in this file is a
# real credential, and nothing real may be added to it.
#
# Local dev loads it explicitly, because `extra="forbid"` on the settings models
# means they read the process environment rather than parsing a dotenv file:
#
#     uv run --env-file .env python -m linking_engine.pipeline.run --tenant demo
#
# Names without a project prefix (VOYAGE_API_KEY, MLFLOW_*, PREFECT_API_URL,
# OLLAMA_HOST) are the vendor SDKs' own variables and are read by those clients
# directly, so they are spelled exactly as the SDK expects.
#
# Per ADR-014 this project runs no services of its own. Neo4j, MongoDB, Prefect
# and MLflow are hosted outside the repository and reached through the endpoints
# and credentials below, which is why every one of them is listed here.


# -- Neo4j -------------------------------------------------------------------
# Externally hosted, standard ports: Bolt on 7687, HTTP browser on 7474.
# 5.18 or later is required - the audit calls vector.similarity.cosine().
# The deployed instance is 5.26 Community with APOC and no GDS (ADR-002).
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URI=http://localhost:7474
NEO4J_USER=neo4j
# Placeholder. The dev compose stack publishes its own throwaway value; match it
# locally and use a sealed secret anywhere else.
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j


# -- MongoDB -----------------------------------------------------------------
# Standalone mongod on 27017, shared with unrelated databases (ADR-013). No
# replica set, so no `replicaSet=` and no `directConnection=` in the URI, and no
# multi-document transactions: every write is single-document and idempotent.
# This project touches only its own database, named here and never enumerated.
MONGO_URI=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin   # percent-encode the password
MONGO_DB=linking_engine


# -- Prefect -----------------------------------------------------------------
# Externally hosted on 4200; its database is owned outside this project, so no
# Postgres credentials belong here. Flows run in-process without a server.
PREFECT_API_URL=http://localhost:4200/api


# -- MLflow ------------------------------------------------------------------
# Remote over HTTPS with built-in basic auth. Artifacts are proxied through the
# tracking server (`mlflow-artifacts:/`), so neither MLFLOW_S3_ENDPOINT_URL nor
# any MinIO or S3 credential belongs in this file.
MLFLOW_TRACKING_URI=https://mlflow.example.invalid
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=


# -- Voyage embeddings -------------------------------------------------------
# Required. Leave empty here; paste the key into `.env` only.
VOYAGE_API_KEY=


# -- Ollama ------------------------------------------------------------------
# Local model, used only to phrase a CONTENT_GAP finding. Never used to write
# anchor text: anchors are extracted from the copy, never generated.
OLLAMA_HOST=http://localhost:11434


# -- Logging -----------------------------------------------------------------
# structlog emits JSON to stdout; Promtail ships it to Loki. No collector.
# Never log page bodies, embeddings, or credentials.
LOG_LEVEL=INFO


# -- Tenant configuration overrides ------------------------------------------
# Real tenants are configured from the Mongo `tenant_config` collection. These
# TENANT_-prefixed variables override the shipped defaults for a local
# single-tenant run; every one is optional and the value shown is the default.
# The one field with no default: a config that does not say whose it is has no
# meaning. Also the value bound to every log line for the run.
TENANT_TENANT_ID=demo
TENANT_EMBEDDING_PROVIDER=VOYAGE_API
TENANT_EMBEDDING_MODEL=voyage-4-large
# Fixed at 2048 to match the Neo4j vector index, whose dimension is set at index
# creation. Changing it is an ADR, not a config edit.
TENANT_EMBEDDING_DIMENSIONS=2048
TENANT_EMBEDDING_LOCAL_FALLBACK_MODEL=voyage-4-nano
TENANT_EMBEDDING_STRATEGY=MULTILINGUAL_EMBED
TENANT_SITE_LANGUAGES=["en","de","fr"]
TENANT_CONTENT_GAP_MODEL=qwen3.5:4b
TENANT_CONTENT_GAP_MIN_PRIORITY=4
TENANT_CONTENT_GAP_MIN_OPPORTUNITY=500
# Nested model; the delimiter is a double underscore.
TENANT_ANCHOR_TYPE_PROFILE__EXACT=0.15
TENANT_ANCHOR_TYPE_PROFILE__PARTIAL=0.20
TENANT_ANCHOR_TYPE_PROFILE__NATURAL=0.50
TENANT_ANCHOR_TYPE_PROFILE__BRANDED=0.15
# Independent flags. Stage 1 ships and runs alone.
TENANT_AUDIT_ENABLED=true
TENANT_DISCOVERY_ENABLED=false
TENANT_CLIENT_TIER=STARTER
TENANT_LIFECYCLE_BOOST_ENABLED=true
TENANT_RESERVED_NEW_PAGE_SLOT_PCT=0.15
TENANT_DIVERSITY_CAP_PCT=0.15
TENANT_MAX_RECOMMENDATIONS_PER_SOURCE=10
