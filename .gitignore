# macOS
.DS_Store

# ── Working material ────────────────────────────────────────────────────────
# Everything under files/ is local scratch, except the tracked docs export.
# Order matters: exclude the contents, then re-include the one directory.
files/*
!files/linking-engine-docs/

# ── Python (evaluation framework) ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.*
!.env.example

# Local data / runs
mlruns/
*.log
.cache/

# Claude Code personal overrides (project settings.json is shared)
.claude/settings.local.json

# cxpak index
.cxpak/

# ── Application stack (linking-engine) ──────────────────────────────────────
# uv.lock is deliberately NOT ignored: the lockfile is committed so CI can
# `uv sync --locked` against the exact resolution developers ran.

# Coverage (pytest --cov, 75% floor)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tooling caches
.import_linter_cache/
.deptry_cache/

# Build artefacts (hatchling)
build/
dist/

# Prefect local state (SQLite backend when running `prefect server start`)
.prefect/

# zvec-grep (zg) local search index
.zvec-grep/
